def exercise_1():
    """
    API Data Fetch and CSV Conversion.
    """
    print("\n--- Exercise 1 ---")
    url = "https://jsonplaceholder.typicode.com/posts"

    # TODO: Request data from API and handle errors.
    try:
        response = requests.get(url, timeout=15)
        response.raise_for_status()
        data = response.json()
        print(f"Successfully fetched {len(data)} posts.")

    except requests.exceptions.RequestException as e:
        print(f"Error fetching data from API: {e}")
        return

    # TODO: Save data to `posts.json`.
    with open("posts.json", "w", encoding="utf-8") as f:
        json.dump(data, f, indent=4)

    print("Created posts.json")

    # TODO: Read `posts.json`.
    with open("posts.json", "r", encoding="utf-8") as f:
        data = json.load(f)

    print("Successfully read posts.json")

    # TODO: Export selected fields to `posts.csv`.
    with open("posts.csv", "w", newline="", encoding="utf-8") as f:
        writer = csv.DictWriter(
            f, fieldnames=["id", "title", "body"]
        )
        writer.writeheader()

        for row in data:
            writer.writerow({
                "id": row["id"],
                "title": row["title"],
                "body": row["body"]
            })

    print("Created posts.csv")
    print("Exercise 1 completed successfully!")

    _ = requests, url
    pass


