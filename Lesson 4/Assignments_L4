import random


def choose_word(word_list):
    """
    Select a secret word.

    Args:
        word_list (list[str]): Candidate words.

    Returns:
        str: Secret word.
    """
    # Pseudo-code:
    # 1. Pick one random word from the list.
    # 2. Return the selected word.

    return random.choice(word_list)


def display_word(secret_word, guessed_letters):
    """
    Build display text with underscores for missing letters.

    Args:
        secret_word (str): Target word.
        guessed_letters (set[str]): Guessed characters.

    Returns:
        str: Display form of the word.
    """
    # Pseudo-code:
    # 1. Start with an empty display.
    # 2. Check every letter in the secret word.
    # 3. Show the letter if it has been guessed.
    # 4. Otherwise show an underscore.
    # 5. Return the completed display.

    display = ""

    for letter in secret_word:
        if letter in guessed_letters:
            display += letter + " "
        else:
            display += "_ "

    return display.strip()


def process_guess(secret_word, guessed_letters, guess, tries_left):
    """
    Update state based on a user guess.

    Args:
        secret_word (str): Target word.
        guessed_letters (set[str]): Existing guesses.
        guess (str): New guess from user.
        tries_left (int): Remaining attempts.

    Returns:
        tuple[set[str], int]: Updated guessed set and tries left.
    """
    # Pseudo-code:
    # 1. Add the guessed letter to guessed_letters.
    # 2. Check whether the letter is in the secret word.
    # 3. If it is not in the word, subtract one try.
    # 4. Return updated guesses and tries.

    guessed_letters.add(guess)

    if guess not in secret_word:
        tries_left -= 1

    return guessed_letters, tries_left


def play_hangman():
    """
    Coordinate one full game round.
    """
    # Pseudo-code:
    # 1. Create a list of possible words.
    # 2. Choose a secret word.
    # 3. Create an empty set for guessed letters.
    # 4. Give the player 6 tries.
    # 5. Continue asking for guesses until win or lose.

    word_list = ["python", "computer", "student", "school", "program"]
    secret_word = choose_word(word_list)

    guessed_letters = set()
    tries_left = 6

    print("\nWelcome to Hangman!")

    while tries_left > 0:

        current_display = display_word(secret_word, guessed_letters)

        print("\nWord:", current_display)
        print("Tries left:", tries_left)

        # Check whether the player has completed the word
        if "_" not in current_display:
            print("Congratulations! You won!")
            return

        guess = input("Enter one letter: ").lower().strip()

        # Validate input
        if len(guess) != 1 or not guess.isalpha():
            print("Please enter only one letter.")
            continue

        # Check for repeated guess
        if guess in guessed_letters:
            print("You already guessed that letter.")
            continue

        guessed_letters, tries_left = process_guess(
            secret_word,
            guessed_letters,
            guess,
            tries_left
        )

        if guess in secret_word:
            print("Good guess!")
        else:
            print("Wrong guess!")

    print("\nYou lost!")
    print("The word was:", secret_word)


if __name__ == "__main__":

    # Pseudo-code:
    # 1. Start the game.
    # 2. Ask the player if they want to play again.
    # 3. Repeat when the answer is yes.
    # 4. Stop when the answer is no.

    while True:

        play_hangman()

        replay = input("\nWould you like to play again? (yes/no): ")
        replay = replay.lower().strip()

        if replay != "yes":
            print("Thanks for playing Hangman!")
            break